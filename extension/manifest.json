{
  "manifest_version": 3,
  "name": "NeuroTask — Tempo de tela",
  "version": "1.0.0",
  "description": "Rastreia tempo de tela em redes sociais e envia insights para o NeuroTask.",
  "permissions": ["storage", "idle", "tabs", "alarms"],
  "host_permissions": ["https://neuro-task-main.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
