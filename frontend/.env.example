# NeuroTask — copie para .env.local e preencha.
# Ver README.md na raiz para o detalhe de cada variável.

# ---- Supabase (obrigatório) ----
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Só no servidor — bypass de RLS no push, na extensão e no webhook do Telegram.
SUPABASE_SERVICE_ROLE_KEY=""

# ---- IA: pelo menos uma ----
# Groq é o padrão e o único provedor com ferramentas (a IA age no app).
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# Gemini: streaming sem ferramentas; também é o fallback de rate limit do Groq.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""

# ---- Push (npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Protege /api/push/dispatch e /api/telegram/setup.
# O MESMO valor vai dentro de supabase/push_cron.sql.
CRON_SECRET=""

# ---- Telegram (opcional) ----
# TELEGRAM_BOT_TOKEN=""
# Sem este segredo qualquer um forja um update e escreve na conta de outra pessoa.
# TELEGRAM_WEBHOOK_SECRET=""

# ---- Opcionais ----
# Fuso dos horários locais em minutos. Padrão 180 (Brasil, UTC-3).
# DEFAULT_TZ_OFFSET_MIN="180"
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL="http://localhost:3000/auth/callback"
